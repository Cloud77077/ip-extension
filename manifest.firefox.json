{
  "manifest_version": 3,
  "name": "IP Extension",
  "version": "1.0.0",
  "description": "A privacy-focused proxy switcher with optional proxy-country timezone matching.",
  "action": {
    "default_title": "IP Extension",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://ipwho.is/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ip-extension@example.invalid",
      "strict_min_version": "121.0"
    }
  }
}
